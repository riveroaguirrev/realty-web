# =============================================================================
# SUPABASE (Local Development & Production)
# =============================================================================
# For local development: Run `supabase start` first, then copy values from output
# For production: Get these from supabase.com dashboard

NEXT_PUBLIC_SUPABASE_URL="http://localhost:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_SUPABASE_URL="http://localhost:54321"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
VITE_API_URL="http://localhost:3000/api"

# =============================================================================
# DATABASE (Prisma with Supabase)
# =============================================================================
# Local: postgresql://postgres:postgres@localhost:54322/postgres
# Production: postgresql://postgres:password@db.region.supabase.co:5432/postgres

DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# =============================================================================
# BACKEND (Next.js)
# =============================================================================
NODE_ENV="development"
NEXT_PUBLIC_API_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:5173"

# =============================================================================
# REDIS (para background jobs y caching)
# =============================================================================
REDIS_URL="redis://localhost:6379"

# =============================================================================
# JWT & SECURITY
# =============================================================================
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRATION="7d"

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================
# Stripe (para pagos/suscripciones)
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# SendGrid (para emails)
SENDGRID_API_KEY="SG...."
SENDGRID_FROM_EMAIL="noreply@realty.com"

# AWS S3 (para subir imágenes)
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-key"
AWS_SECRET_ACCESS_KEY="your-secret"
AWS_S3_BUCKET="realty-images"

# =============================================================================
# LOGGING & MONITORING
# =============================================================================
LOG_LEVEL="info"
SENTRY_DSN="https://..."

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_MATCHING_ENGINE="true"
ENABLE_NOTIFICATIONS="true"
ENABLE_ANALYTICS="false"
