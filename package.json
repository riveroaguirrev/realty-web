{
  "name": "realty-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Real estate platform with organizations, advisors, and property management",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "npx prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "npx prisma studio --schema=./prisma/schema.prisma"
  },
  "keywords": [
    "real-estate",
    "immobiliaria",
    "properties",
    "advisors"
  ],
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "react-router-dom": "^6.30.6"
  }
}
