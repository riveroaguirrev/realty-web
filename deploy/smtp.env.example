# Copy to .env.smtp.local at repository root (ignored by Git).
# Used only to configure Supabase Auth; never add these secrets to VITE_* variables.
# Fill with your SMTP provider's values and a verified sender address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=Realty
